# Required: exact external HTTPS origin. Include a public port if nonstandard.
CHRONEXUS_PUBLIC_ORIGIN=https://sync.example.org

# Optional: application mapping stays loopback-only behind your HTTPS proxy.
# CHRONEXUS_BIND_ADDRESS=127.0.0.1
# CHRONEXUS_HOST_PORT=8080
# CHRONEXUS_INTERNAL_PORT=8080

# Default: the host reverse proxy reaches the app through this bridge gateway.
# Set explicit proxy IPs/CIDRs for a different topology; never trust all addresses.
# CHRONEXUS_TRUSTED_PROXIES=172.30.253.1/32
# CHRONEXUS_NETWORK_SUBNET=172.30.253.0/24
# CHRONEXUS_NETWORK_GATEWAY=172.30.253.1
# If you change the gateway, also change CHRONEXUS_TRUSTED_PROXIES.
