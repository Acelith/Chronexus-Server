# ---------------------------------------------------------------------------
# Chronexus Server configuration. Copy to .env and set ONE thing: your domain.
# ---------------------------------------------------------------------------

# Required: the public host name users will type in Chronexus (no scheme, no path).
# It must already point (DNS A/AAAA) at this machine when you use the bundled HTTPS proxy.
CHRONEXUS_DOMAIN=sync.example.org

# --- Mode A: bundled HTTPS (nothing else to install) -----------------------
#   docker compose --profile https up -d
# Caddy obtains and renews the certificate by itself. Ports 80 and 443 must be reachable.
# CHRONEXUS_HTTP_PORT=80
# CHRONEXUS_HTTPS_PORT=443

# --- Mode B: your own reverse proxy ----------------------------------------
#   docker compose up -d
# The app listens on loopback only; point your proxy at it (see docs/INSTALLATION.md).
# CHRONEXUS_BIND_ADDRESS=127.0.0.1
# CHRONEXUS_HOST_PORT=8080
# CHRONEXUS_INTERNAL_PORT=8080

# --- Optional overrides -----------------------------------------------------
# Exact public origin, only for a nonstandard external port (otherwise derived from the domain):
# CHRONEXUS_PUBLIC_ORIGIN=https://sync.example.org:8443
# Use a published image instead of building from source:
# CHRONEXUS_IMAGE=chronexus-server:local
# Network: change all of these together if 172.30.253.0/24 is already in use.
# Never trust all addresses as proxies.
# CHRONEXUS_NETWORK_SUBNET=172.30.253.0/24
# CHRONEXUS_NETWORK_GATEWAY=172.30.253.1
# CHRONEXUS_PROXY_IP=172.30.253.2
# CHRONEXUS_NETWORK_DYNAMIC_RANGE=172.30.253.128/25
# CHRONEXUS_TRUSTED_PROXIES=172.30.253.1/32,172.30.253.2/32
# Operator role in the web interface (service status, account metadata; never campaign content):
# CHRONEXUS_OPERATORS=your-user-name
