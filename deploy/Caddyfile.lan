# A LAN IP cannot use a public DNS certificate. Caddy keeps its local CA in
# proxy-data; install its root certificate on each Chronexus client device.
{$CHRONEXUS_DOMAIN} {
	tls internal
	log {
		output discard
	}
	reverse_proxy server:{$CHRONEXUS_INTERNAL_PORT:8080} {
		flush_interval -1
		transport http {
			read_timeout 15m
		}
		header_up Host {http.request.hostport}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}
	}
}
