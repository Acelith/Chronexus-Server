{
  "components": {
    "schemas": {
      "DeviceSession": {
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "device": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "lastUsedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "device",
          "createdAt",
          "lastUsedAt",
          "expiresAt",
          "current"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "device": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "device"
        ],
        "type": "object"
      },
      "Meta": {
        "properties": {
          "api": {
            "type": "string"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "serverVersion": {
            "type": "string"
          },
          "version": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "api",
          "version",
          "serverVersion",
          "capabilities"
        ],
        "type": "object"
      },
      "Recover": {
        "additionalProperties": false,
        "properties": {
          "device": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "recoveryCode": {
            "type": "string"
          }
        },
        "required": [
          "recoveryCode",
          "password",
          "device"
        ],
        "type": "object"
      },
      "Redeem": {
        "additionalProperties": false,
        "properties": {
          "device": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "inviteCode": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "inviteCode",
          "username",
          "displayName",
          "password",
          "device"
        ],
        "type": "object"
      },
      "SignedIn": {
        "properties": {
          "accountId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "accountId",
          "username",
          "displayName"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "S1/S2 subset of Chronexus sync protocol v1. Campaign/sharing routes are not implemented. No browser UI yet.",
